{
  "name": "planesview",
  "version": "0.1.0",
  "description": "Real-time aircraft globe with immersive cockpit POV. Free data sources, no API key, no backend.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "maplibre-gl": "^6.10.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
